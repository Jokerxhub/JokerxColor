# ===== 基础配置 =====
PORT=1314
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DATABASE_PATH=/app/data/colors.db

# ===== 认证配置 =====
# 是否要求登录才能访问（true/false）
AUTH_REQUIRED=false
# 默认管理员账号：admin / admin（首次启动自动创建，登录后请修改）

# ===== Casdoor SSO 配置（可选） =====
CASDOOR_ENABLED=false
CASDOOR_ENDPOINT=https://casdoor.example.com
CASDOOR_CLIENT_ID=your-client-id
CASDOOR_CLIENT_SECRET=your-client-secret
CASDOOR_ORG_NAME=your-org
CASDOOR_APP_NAME=your-app
# 回调地址：留空则自动根据访问地址生成（推荐，自动适配 IP/域名/HTTP/HTTPS）
# 仅在反代配置特殊时才需要手动指定，例如：
# CASDOOR_REDIRECT_URI=https://color.example.com/auth/casdoor/callback
CASDOOR_REDIRECT_URI=
